# Server Configuration
PORT=3000

# PayPal Sandbox Credentials (https://developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here

# Anthropic Claude API Key (for Agent Tool-Calling and Receipt Scanner Vision)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Club Safety Limits
MAX_SINGLE_PAYOUT_LIMIT=250.00
DUAL_APPROVAL_THRESHOLD=75.00
